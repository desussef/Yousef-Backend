APP_ENV=development
PORT=3001
DATABASE_URL=postgresql://portfolio_app:change-me@localhost:5432/yousef_portfolio
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
SESSION_TTL_HOURS=24
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
# Production media (AWS S3 or S3-compatible providers such as Cloudflare R2)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
# SMTP is optional locally. Without it, reset messages are logged only in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Yousef Portfolio <no-reply@example.com>
